# Copie este arquivo para .env e preencha com as URLs do Neon.
# Use a connection string SEM pooling (o host não deve conter "-pooler").
# Pode colar no formato do Neon (postgresql://...); a aplicação ajusta o driver.

# Banco usado pela aplicação (local: branch dev | Render: branch produção)
DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require

# Banco usado pelo pytest (branch test). Os testes APAGAM dados deste banco.
TEST_DATABASE_URL=postgresql://usuario:senha@host.neon.tech/neondb?sslmode=require
